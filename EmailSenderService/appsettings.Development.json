{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "EmailSenderService": "Debug"
    }
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "FromAddress": "noreply@localhost",
    "FromDisplayName": "Email Sender (dev)"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/master",
    "Audience": "email-sender",
    "ValidateAudience": false,
    "RequireHttpsMetadata": false,
    "RequiredRole": "email-sender",
    "RolesClientId": "email-sender",
    "SwaggerClientId": "email-sender-swagger"
  },
  "Vault": {
    "Enabled": false,
    "Address": "http://localhost:8200",
    "AuthMethod": "Token",
    "Optional": true
  }
}
