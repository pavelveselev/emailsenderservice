@host = http://localhost:5158

# Получение токена в Keycloak. Для конфиденциального клиента используйте client_credentials, как ниже;
# для пользовательского клиента - кнопку Authorize в Swagger UI.
# @name token
POST http://localhost:8080/realms/master/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=email-sender&client_secret=REPLACE_ME

###

@accessToken = {{token.response.body.access_token}}

### Обычный текст
POST {{host}}/api/email/send
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "to": ["someone@example.com"],
  "subject": "Deployment finished",
  "body": "Release 1.4.2 is live.",
  "isHtml": false
}

### HTML с cc и reply-to
POST {{host}}/api/email/send
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "to": ["someone@example.com", "other@example.com"],
  "cc": ["team@example.com"],
  "replyTo": "support@example.com",
  "subject": "Weekly report",
  "body": "<h1>Weekly report</h1><p>All systems <strong>nominal</strong>.</p>",
  "isHtml": true
}

### С вложениями: те же поля в виде multipart/form-data, списки - повторяющимися ключами
POST {{host}}/api/email/send
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="to"

someone@example.com
--boundary
Content-Disposition: form-data; name="to"

other@example.com
--boundary
Content-Disposition: form-data; name="subject"

Quarterly report
--boundary
Content-Disposition: form-data; name="body"

The report is attached.
--boundary
Content-Disposition: form-data; name="attachments"; filename="report.txt"
Content-Type: text/plain

Revenue up, costs down.
--boundary--

### Readiness (анонимно)
GET {{host}}/healthz/ready
