{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": true
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "UserName": "",
    "FromAddress": "",
    "FromDisplayName": "",
    "TimeoutSeconds": 30,
    "AcceptInvalidCertificates": false
  },
  "Keycloak": {
    "Authority": "",
    "Audience": "email-sender",
    "ValidateAudience": true,
    "RequireHttpsMetadata": true,
    "RequiredRole": "email-sender",
    "RolesClientId": "email-sender",
    "SwaggerClientId": "email-sender-swagger"
  },
  "Vault": {
    "Enabled": false,
    "Address": "http://vault:8200",
    "AuthMethod": "Kubernetes",
    "KubernetesRole": "email-sender",
    "KubernetesAuthMountPoint": "kubernetes",
    "MountPoint": "secret",
    "SecretPath": "email-sender/smtp",
    "ConfigurationPrefix": "Smtp",
    "Optional": false,
    "ReloadInterval": "00:05:00"
  }
}
