{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": true
  },
  "RequestLimits": {
    "MaxBodyMegabytes": 100
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "UserName": "",
    "FromAddress": "",
    "FromDisplayName": "",
    "TimeoutSeconds": 30,
    "AcceptInvalidCertificates": false
  },
  "Keycloak": {
    "Authority": "",
    "Audience": "email-sender",
    "ValidateAudience": true,
    "RequireHttpsMetadata": true,
    "RequiredRole": "email-sender",
    "RolesClientId": "email-sender"
  }
}
